# Copier ce fichier en .env puis remplir. Ne JAMAIS commiter le fichier .env.

# Fournisseur LLM : "fake" (démo hors ligne, sans clé), "anthropic", "openai" ou "gemini" (stubs)
LLM_PROVIDER=fake

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Nom du modèle, jamais écrit en dur dans le code (ex. claude-sonnet-5-5)
ANTHROPIC_MODEL=

# --- Stubs (non implémentés, montrent que l'architecture est multi-fournisseurs) ---
OPENAI_API_KEY=
OPENAI_MODEL=
GEMINI_API_KEY=
GEMINI_MODEL=
