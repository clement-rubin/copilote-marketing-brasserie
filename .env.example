# Copier ce fichier en .env puis remplir. Ne JAMAIS commiter le fichier .env.

# Fournisseur LLM : "fake" (démo hors ligne, sans clé), "gemini", "anthropic" ou "openai" (stub)
LLM_PROVIDER=fake

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Nom du modèle, jamais écrit en dur dans le code (ex. claude-sonnet-5-5)
ANTHROPIC_MODEL=

# --- Gemini (si LLM_PROVIDER=gemini) : clé gratuite sur https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# Nom du modèle (ex. gemini-2.5-flash)
GEMINI_MODEL=

# --- OpenAI : stub non implémenté, montre où brancher un autre fournisseur ---
OPENAI_API_KEY=
OPENAI_MODEL=
