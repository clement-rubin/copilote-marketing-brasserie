# Copier ce fichier en .env puis remplir. Ne JAMAIS commiter le fichier .env.

# Fournisseur LLM : "fake" (démo hors ligne, sans clé), "gemini", "anthropic" ou "openai"
LLM_PROVIDER=fake

# --- Anthropic (si LLM_PROVIDER=anthropic) ---
ANTHROPIC_API_KEY=
# Nom du modèle, jamais écrit en dur dans le code (ex. claude-sonnet-5-5)
ANTHROPIC_MODEL=

# --- Gemini (si LLM_PROVIDER=gemini) : clé gratuite sur https://aistudio.google.com/apikey ---
GEMINI_API_KEY=
# Modèle(s), séparés par des virgules : le suivant sert de secours si le premier est saturé
# (ex. gemini-3.8-flash,gemini-3.1-flash-lite ; la liste disponible dépend du compte et évolue)
GEMINI_MODEL=

# --- OpenAI (si LLM_PROVIDER=openai, et pour les images DALL-E / gpt-image) ---
OPENAI_API_KEY=
OPENAI_MODEL=

# --- Génération d'images : "placeholder" (maquette SVG hors ligne) ou "openai" ---
IMAGE_PROVIDER=placeholder
# Modèle d'image OpenAI (ex. dall-e-3 ou gpt-image-1), utilise OPENAI_API_KEY
IMAGE_MODEL=

# --- Publication : "mock" (simulation dans out/published) ou "live" (vraies API) ---
PUBLISH_MODE=mock

# LinkedIn (page entreprise, produit Community Management API approuvé)
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORGANIZATION_ID=
# Version de l'API au format AAAAMM
LINKEDIN_API_VERSION=

# Meta (compte Instagram professionnel, page Facebook, permissions validées par App Review)
META_ACCESS_TOKEN=
# Version de la Graph API (ex. v21.0) et hôte (graph.facebook.com ou graph.instagram.com)
META_GRAPH_VERSION=
META_GRAPH_HOST=graph.facebook.com
INSTAGRAM_USER_ID=
# Optionnel : relayer les posts Instagram sur la page Facebook
FACEBOOK_PAGE_ID=
